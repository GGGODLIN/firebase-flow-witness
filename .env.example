# Firebase AI Logic cloud tier. Copy to .env.local and rebuild.
# Leave the three required values empty to run without a Firebase project:
# Gemini Nano still answers on-device, and anything that needs the cloud shows
# a labelled "Deterministic Replay (No Firebase Env)" instead of a fake answer.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: reCAPTCHA Enterprise site key. When set, App Check is initialised
# before getAI() on the first cloud call.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Optional: cloud model override. Empty uses the engine default.
NEXT_PUBLIC_FIREBASE_AI_MODEL=
